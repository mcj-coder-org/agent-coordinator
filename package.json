{
  "name": "agent-coordinator",
  "version": "0.1.0",
  "description": "Git-based parallel AI agent coordinator",
  "private": true,
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:e2e": "bash tests/e2e.sh",
    "test:smoke": "bash tests/smoke.sh",
    "lint:sh": "shellcheck bin/*.sh",
    "lint:fmt": "prettier --check .",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "check": "npm test && npm run test:e2e && npm run lint:sh && npm run lint:fmt && npm run lint:md",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json}": "prettier --write",
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ],
    "*.sh": "shfmt -w"
  },
  "devDependencies": {
    "husky": "^9",
    "lint-staged": "^15",
    "markdownlint-cli2": "^0.17",
    "prettier": "^3",
    "shellcheck": "^4"
  }
}
